<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestnotes.controller.ConnexionController"
      alignment="CENTER" spacing="15"
      style="-fx-background-color: #2c3e50; -fx-padding: 40;">

    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <Label text="GestNotes"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>

    <Label text="Système de Gestion des Notes"
           style="-fx-text-fill: #bdc3c7; -fx-font-size: 13px;"/>

    <VBox spacing="8" maxWidth="300" alignment="CENTER_LEFT"
          style="-fx-padding: 10 0 0 0;">

        <Label text="Nom d'utilisateur" style="-fx-text-fill: white;"/>
        <TextField fx:id="usernameField" promptText="Entrez votre nom d'utilisateur"
                   maxWidth="300"
                   style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-prompt-text-fill: #7f8c8d; -fx-border-color: #3498db; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 8;"/>

        <Label text="Mot de passe" style="-fx-text-fill: white;"/>
        <PasswordField fx:id="passwordField" promptText="Entrez votre mot de passe"
                       maxWidth="300"
                       style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-prompt-text-fill: #7f8c8d; -fx-border-color: #3498db; -fx-border-radius: 3; -fx-background-radius: 3; -fx-padding: 8;"/>
    </VBox>

    <Button fx:id="loginButton" text="Se connecter" onAction="#handleLogin"
            maxWidth="300"
            style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-cursor: hand; -fx-border-radius: 3; -fx-background-radius: 3;"/>

    <Label fx:id="errorLabel" text=""
           style="-fx-text-fill: #e74c3c; -fx-font-size: 12px;"/>

</VBox>
