<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestnotes.controller.EtudiantController"
      spacing="10" style="-fx-padding: 15; -fx-background-color: #ecf0f1;">

    <stylesheets>
        <URL value="@styles.css"/>
    </stylesheets>

    <!-- Title + Search -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <Label text="Gestion des Étudiants"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Recherche:"/>
        <TextField fx:id="rechercheField" promptText="Nom, prénom, CIN, filière..."
                   prefWidth="220" onKeyReleased="#handleRecherche"/>
    </HBox>

    <!-- Form + Buttons -->
    <HBox spacing="15">
        <!-- Form -->
        <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-border-radius: 5; -fx-background-radius: 5;"
              spacing="8" HBox.hgrow="ALWAYS">
            <Label text="Formulaire Étudiant"
                   style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <GridPane hgap="10" vgap="8">
                <Label text="Nom:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="nomField" promptText="Nom" GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="180"/>

                <Label text="Prénom:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="prenomField" promptText="Prénom" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="CIN:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="cinField" promptText="CIN unique" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Email:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="emailField" promptText="email@example.com" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Téléphone:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="telephoneField" promptText="Chiffres seulement" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

                <Label text="Date naissance:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
                <DatePicker fx:id="dateNaissancePicker" GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="180"/>

                <Label text="Niveau:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
                <ComboBox fx:id="niveauCombo" GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="180"/>

                <Label text="Filière:" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
                <ComboBox fx:id="filiereCombo" GridPane.columnIndex="1" GridPane.rowIndex="7" prefWidth="180"/>

                <Label text="Groupe:" GridPane.columnIndex="0" GridPane.rowIndex="8"/>
                <ComboBox fx:id="groupeCombo" GridPane.columnIndex="1" GridPane.rowIndex="8" prefWidth="180"/>
            </GridPane>
        </VBox>

        <!-- Buttons -->
        <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 15 0 0 0;">
            <Button fx:id="ajouterBtn" text="Ajouter" onAction="#handleAjouter"
                    styleClass="btn-primary" prefWidth="120" prefHeight="35"/>
            <Button fx:id="modifierBtn" text="Modifier" onAction="#handleModifier"
                    prefWidth="120" prefHeight="35"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-cursor: hand;"/>
            <Button fx:id="supprimerBtn" text="Supprimer" onAction="#handleSupprimer"
                    styleClass="btn-danger" prefWidth="120" prefHeight="35"/>
            <Button fx:id="reinitialiserBtn" text="Réinitialiser" onAction="#handleReinitialiser"
                    prefWidth="120" prefHeight="35"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand;"/>
        </VBox>
    </HBox>

    <!-- Table -->
    <TableView fx:id="etudiantTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="40"/>
            <TableColumn fx:id="colNom" text="Nom" prefWidth="100"/>
            <TableColumn fx:id="colPrenom" text="Prénom" prefWidth="100"/>
            <TableColumn fx:id="colCin" text="CIN" prefWidth="90"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="150"/>
            <TableColumn fx:id="colTelephone" text="Téléphone" prefWidth="100"/>
            <TableColumn fx:id="colDateNaissance" text="Date Naiss." prefWidth="90"/>
            <TableColumn fx:id="colNiveau" text="Niveau" prefWidth="60"/>
            <TableColumn fx:id="colFiliere" text="Filière" prefWidth="70"/>
            <TableColumn fx:id="colGroupe" text="Groupe" prefWidth="60"/>
        </columns>
        <placeholder><Label text="Aucun étudiant trouvé"/></placeholder>
    </TableView>

</VBox>
